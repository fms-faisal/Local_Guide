  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "postcss": "^8.5.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0"
  }
}
